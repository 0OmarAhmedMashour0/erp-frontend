{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/contracts/schemas/inventory.json",
  "title": "Pharmacy ERP — Inventory Contract (Stage 1)",
  "description": "Locations, batches, balances, append-only ledger, adjustments. Balances are a projection; the ledger (INVENTORY_TXN + lines) is authoritative. FE never picks batch/location for returns — the server derives them from posted allocations. Initial stock is NEVER pushed by cloud; it is posted locally via OPENING_BALANCE.",
  "$defs": {
    "LocationType": {
      "type": "string",
      "enum": ["SELLABLE", "QUARANTINE", "DAMAGED", "SCRAP"],
      "description": "is_sellable=true is permitted only for SELLABLE; the other three are always non-sellable."
    },
    "BatchQualityStatus": {
      "type": "string",
      "enum": ["AVAILABLE", "QUARANTINED", "EXPIRED", "RECALLED"],
      "description": "Never sellable: expired-by-date, RECALLED, QUARANTINED, or in a non-sellable location. Date eligibility is checked independently of stored status."
    },
    "InventoryLocationDto": {
      "type": "object",
      "required": ["location_id", "branch_id", "location_code", "name", "location_type", "is_sellable", "is_active"],
      "properties": {
        "location_id": { "type": "string", "format": "uuid" },
        "branch_id": { "type": "string", "format": "uuid" },
        "location_code": { "type": "string", "maxLength": 30 },
        "name": { "type": "string", "maxLength": 100 },
        "location_type": { "$ref": "#/$defs/LocationType" },
        "is_sellable": { "type": "boolean" },
        "is_active": { "type": "boolean" }
      }
    },
    "InventoryLocationRequest": {
      "type": "object",
      "required": ["branch_id", "location_code", "name", "location_type"],
      "properties": {
        "branch_id": { "type": "string", "format": "uuid" },
        "location_code": { "type": "string", "maxLength": 30 },
        "name": { "type": "string", "maxLength": 100 },
        "location_type": { "$ref": "#/$defs/LocationType" },
        "is_active": { "type": "boolean", "default": true }
      }
    },
    "InventoryLocationPatchRequest": {
      "type": "object",
      "properties": {
        "name": { "type": ["string", "null"], "maxLength": 100 },
        "location_type": { "$ref": "#/$defs/LocationType" },
        "is_active": { "type": ["boolean", "null"] }
      }
    },
    "InventoryBatchDto": {
      "type": "object",
      "description": "READ-ONLY via API: batch rows are created only by opening-balance/receipt ledger workflows.",
      "required": ["batch_id", "product_id", "batch_number", "quality_status"],
      "properties": {
        "batch_id": { "type": "string", "format": "uuid", "description": "Deterministic UUIDv5 (RFC 4122 DNS namespace); identical for the same (organization, product, batch_number, expires_on) across ALL branches." },
        "product_id": { "type": "string", "format": "uuid" },
        "batch_number": { "type": "string", "maxLength": 80, "description": "Exact, case-sensitive; never trimmed/case-folded." },
        "manufactured_on": { "type": ["string", "null"], "format": "date", "description": "Optional; when present cannot exceed expires_on." },
        "expires_on": { "type": ["string", "null"], "format": "date", "description": "Required for lot-tracked products; NULL only for the reserved NON-LOT batch of lot_tracking_required=false products." },
        "quality_status": { "$ref": "#/$defs/BatchQualityStatus" },
        "is_non_lot": { "type": "boolean", "readOnly": true, "description": "True for reserved batch_number=NON-LOT with NULL dates." }
      }
    },
    "InventoryBalanceDto": {
      "type": "object",
      "description": "Concurrency-safe projection over the ledger. Unique (organization, location, batch).",
      "required": ["product_id", "branch_id", "location_id", "batch_id", "on_hand_qty_base", "average_unit_cost", "available_qty_base"],
      "properties": {
        "product_id": { "type": "string", "format": "uuid" },
        "branch_id": { "type": "string", "format": "uuid" },
        "location_id": { "type": "string", "format": "uuid" },
        "batch_id": { "type": "string", "format": "uuid" },
        "on_hand_qty_base": { "$ref": "common.json#/$defs/Numeric4", "description": ">=0 always." },
        "average_unit_cost": { "$ref": "common.json#/$defs/Numeric4", "description": "Location-and-batch weighted average (>=0)." },
        "available_qty_base": { "$ref": "common.json#/$defs/Numeric4", "description": "Server-derived eligible stock; equals on_hand in MVP because there are no reservations." },
        "row_version": { "type": "integer", "readOnly": true, "description": "Optimistic concurrency token." },
        "updated_at": { "$ref": "common.json#/$defs/Timestamp" }
      }
    },
    "InventoryTxnType": {
      "type": "string",
      "enum": [
        "OPENING_BALANCE",
        "ADJUSTMENT_IN",
        "ADJUSTMENT_OUT",
        "SALE_ISSUE",
        "SALES_RETURN_IN",
        "PURCHASE_RECEIPT",
        "VENDOR_RETURN_OUT",
        "SCRAP_OUT",
        "REVERSAL"
      ],
      "description": "Sign convention: IN/receipt types positive, ISSUE/OUT types negative. REVERSAL exactly negates its original; the original stays POSTED and immutable."
    },
    "InventoryTxnStatus": {
      "type": "string",
      "enum": ["DRAFT", "POSTED", "CANCELLED"],
      "description": "Edits allowed only while DRAFT. POSTED rows + lines are immutable (DB-enforced). CANCELLED is for unposted drafts only."
    },
    "InventoryTxnLineDto": {
      "type": "object",
      "required": ["inventory_txn_line_id", "product_id", "location_id", "batch_id", "product_uom_id", "entered_qty", "conversion_snapshot", "quantity_delta_base"],
      "properties": {
        "inventory_txn_line_id": { "type": "string", "format": "uuid" },
        "product_id": { "type": "string", "format": "uuid" },
        "location_id": { "type": "string", "format": "uuid" },
        "batch_id": { "type": "string", "format": "uuid", "description": "NOT NULL; NON-LOT sentinel for non-lot-tracked products." },
        "product_uom_id": { "type": "string", "format": "uuid", "description": "Product's BASE UOM for ledger lines." },
        "entered_qty": { "$ref": "common.json#/$defs/Numeric4", "description": "= abs(quantity_delta_base) on ledger lines." },
        "conversion_snapshot": { "$ref": "common.json#/$defs/Numeric6", "description": "= 1 on ledger lines." },
        "quantity_delta_base": { "$ref": "common.json#/$defs/Numeric4", "description": "Signed; never 0." },
        "unit_cost_base": { "$ref": "common.json#/$defs/Numeric4" },
        "sales_order_line_id": { "type": ["string", "null"], "format": "uuid" },
        "sales_return_line_id": { "type": ["string", "null"], "format": "uuid" },
        "purchase_order_line_id": { "type": ["string", "null"], "format": "uuid" },
        "vendor_return_line_id": { "type": ["string", "null"], "format": "uuid" }
      }
    },
    "InventoryTxnDto": {
      "type": "object",
      "required": ["inventory_txn_id", "branch_id", "transaction_no", "transaction_type", "status", "lines"],
      "properties": {
        "inventory_txn_id": { "type": "string", "format": "uuid" },
        "branch_id": { "type": "string", "format": "uuid" },
        "transaction_no": { "type": "string", "maxLength": 40 },
        "transaction_type": { "$ref": "#/$defs/InventoryTxnType" },
        "status": { "$ref": "#/$defs/InventoryTxnStatus" },
        "reason_code": { "type": ["string", "null"], "maxLength": 40 },
        "note": { "type": ["string", "null"], "maxLength": 500 },
        "posted_at": { "$ref": "common.json#/$defs/Timestamp" },
        "created_by_employee_id": { "type": "string", "format": "uuid" },
        "reverses_inventory_txn_id": { "type": ["string", "null"], "format": "uuid" },
        "sales_order_id": { "type": ["string", "null"], "format": "uuid" },
        "sales_return_id": { "type": ["string", "null"], "format": "uuid" },
        "purchase_order_id": { "type": ["string", "null"], "format": "uuid" },
        "vendor_return_id": { "type": ["string", "null"], "format": "uuid" },
        "lines": { "type": "array", "items": { "$ref": "#/$defs/InventoryTxnLineDto" } }
      }
    },
    "InventoryTxnLineRequest": {
      "type": "object",
      "description": "One line per FE input. Ledger stores base-UOM representation; conversion fields are snapshotted server-side.",
      "required": ["product_id", "location_id", "batch_id", "entered_qty", "product_uom_id"],
      "properties": {
        "product_id": { "type": "string", "format": "uuid" },
        "location_id": { "type": "string", "format": "uuid" },
        "batch_id": { "type": "string", "format": "uuid", "description": "Use the system NON-LOT batch (get its id from /inventory/batches) for non-lot-tracked products." },
        "product_uom_id": { "type": "string", "format": "uuid" },
        "entered_qty": { "$ref": "common.json#/$defs/Numeric4", "description": ">0 in the entered UOM." },
        "unit_cost_base": { "$ref": "common.json#/$defs/Numeric4", "description": "REQUIRED for ADJUSTMENT_IN / OPENING_BALANCE. Omitted for ADJUSTMENT_OUT; the server uses the current balance cost. Reversals/RESTOCK reuse the original posted cost." }
      }
    },
    "InventoryTxnRequest": {
      "type": "object",
      "required": ["transaction_type", "branch_id", "lines"],
      "properties": {
        "transaction_type": {
          "allOf": [{ "$ref": "#/$defs/InventoryTxnType" }],
          "description": "Permissible for /inventory/adjustments: OPENING_BALANCE, ADJUSTMENT_IN, ADJUSTMENT_OUT, REVERSAL."
        },
        "branch_id": { "type": "string", "format": "uuid" },
        "reason_code": { "type": ["string", "null"], "maxLength": 40 },
        "note": { "type": ["string", "null"], "maxLength": 500 },
        "reverses_inventory_txn_id": { "type": ["string", "null"], "format": "uuid", "description": "REQUIRED when transaction_type=REVERSAL." },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/InventoryTxnLineRequest" }
        }
      }
    }
  }
}
